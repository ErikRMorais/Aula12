    {
      "parameters": {
        "jsCode": "// Tabela de palavras-chave do post. A primeira regra que casar define a\n// resposta.\n// Toda resposta termina identificando que foi automática.\nconst regras = [\n  { palavras: ['meme', 'engraçado', 'engracado', 'kkk', 'haha', 'rindo'],\n    resposta: 'Que bom que você curtiu! 😄' },\n  { palavras: ['programador', 'programação', 'programacao', 'código', 'codigo', 'bug'],\n    resposta: 'Vida de programador é isso mesmo! Qual linguagem você mais usa?' },\n  { palavras: ['n8n', 'workflow', 'automação', 'automacao', 'robô', 'robo'],\n    resposta: 'Esta resposta foi enviada por um workflow do n8n, numa conta de teste de automação.' },\n  { palavras: ['parabéns', 'parabens', 'obrigado', 'obrigada', 'valeu', 'show'],\n    resposta: 'Obrigado! 🙌' },\n];\nconst normalizar = (t) => t.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst saida = [];\nfor (const item of $input.all()) {\n  const texto = normalizar(item.json.texto ?? '');\n  const regra = regras.find(r => r.palavras.some(p => texto.includes(normalizar(p))));\n  if (!regra) continue;                       // sem palavra-chave: não responde\n  saida.push({ json: { ...item.json, palavra: regra.palavras[0],\n    resposta: `${regra.resposta} (resposta automática)` } });\n}\nreturn saida;"
      },
